# ------------------------------ 依赖 ------------------------------
node_modules/

# ------------------------------ 构建产物 ------------------------------
public/
db.json
.deploy_git/
.hexo/

# ------------------------------ 图片 ------------------------------
# 图片只保存在本地：构建时增量上传到 ImgBB，页面里用的是图床链接。
# 清单文件 tools/image-manifest.json 需要提交，它记录了「哪张图已经传过」。
# 注意：这里要写成 /img/（锚定仓库根目录），否则会连带忽略
# themes/lawson/source/img/ 里的主题图标。
/img/
/source/images/

# ------------------------------ 密钥 ------------------------------
.env
*.pem

# ------------------------------ 系统文件 ------------------------------
.DS_Store
**/.DS_Store
Thumbs.db
desktop.ini

# ------------------------------ 日志 / 临时文件 ------------------------------
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache
*.bak
*.tmp
tmp/

# ------------------------------ 编辑器 / IDE ------------------------------
.idea/
.vscode/
*.swp
*.swo
