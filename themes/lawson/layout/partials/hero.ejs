<%
  const L = site.lawson;
%>
<section class="hero" id="hero">
  <div class="hero__inner">
    <% L.theme.skins.forEach(function (skin) { %>
      <p class="hero__eyebrow" data-only-skin="<%= skin.id %>"><%= skin.tagline || skin.name %></p>
    <% }); %>

    <h1 class="hero__title"><%= L.hero.title %></h1>

    <p class="hero__sub">
      <span class="hero__type" data-typewriter aria-live="polite"></span><span class="hero__caret" aria-hidden="true"></span>
    </p>

    <div class="hero__actions">
      <a class="btn btn--primary" href="#intro">
        <span>开始阅读</span>
        <svg class="icon" aria-hidden="true"><use href="#icon-arrow-right"></use></svg>
      </a>
      <a class="btn btn--glass" href="<%= url_for('about/') %>">关于我</a>
    </div>
  </div>

  <a class="hero__scroll" href="#intro">
    <span><%= L.hero.scroll_hint %></span>
    <svg class="icon" aria-hidden="true"><use href="#icon-arrow-down"></use></svg>
  </a>

  <%
    const splash = L.splash || {};
    const splashOutline = Number(splash.outline_width) > 0;
    const splashStyle = [
      '--splash-color:' + (splash.color || '#ffec4f'),
      '--splash-outline:' + (splash.outline_color || '#ffffff'),
      '--splash-outline-width:' + (splashOutline ? Number(splash.outline_width) : 0) + 'px',
      '--splash-shadow:' + (splash.shadow_color || '#3f3f00'),
      '--splash-angle:' + (splash.angle === undefined ? -14 : splash.angle) + 'deg',
      splash.pulse === false
        ? '--splash-animation:none'
        : '--splash-pulse-duration:' + (1 / (Number(splash.pulse_speed) || 0.9)).toFixed(2) + 's; --splash-pulse-scale:' + (1 + (Number(splash.pulse_scale) || 0.09)).toFixed(3)
    ].join(';');
  %>
  <% if (splash.enabled !== false && splash.text) { %>
    <span class="hero__splash" data-splash data-splash-font="<%= splash.font || 'unifont' %>" data-splash-outline="<%= splashOutline ? 'on' : 'off' %>" style="<%= splashStyle %>" aria-hidden="true"><%= splash.text %></span>
  <% } %>
</section>
