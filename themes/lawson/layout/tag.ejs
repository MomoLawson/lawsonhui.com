<%
  const posts = page.posts ? page.posts.toArray() : [];
  const allTags = site.tags ? site.tags.toArray() : [];
%>
<div class="sheet">
  <section class="section section--taxonomy">
    <header class="page-head reveal">
      <p class="eyebrow">Tag</p>
      <h1 class="page-title"><%= page.tag ? '# ' + page.tag : '标签' %></h1>
      <p class="page-lead"><%= page.tag ? '共 ' + posts.length + ' 篇相关文章' : '共 ' + allTags.length + ' 个标签' %></p>
    </header>

    <% if (!page.tag) { %>
      <ul class="chips chips--large reveal">
        <% allTags.forEach(function (tag) { %>
          <li>
            <a class="chip chip--link" href="<%= url_for(tag.path) %>">
              <span># <%= tag.name %></span>
              <span class="chip__count"><%= tag.length %></span>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } else { %>
      <ul class="post-list">
        <% posts.forEach(function (post) { %>
          <li class="post-list__item reveal">
            <a class="post-list__link" href="<%= url_for(post.path) %>">
              <span class="post-list__title"><%= post.title %></span>
              <time class="post-list__date" datetime="<%= post.date.toISOString() %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
            </a>
          </li>
        <% }); %>
      </ul>
    <% } %>
  </section>
</div>
